{
  "manifest_version": 3,
  "name": "LanguageTool Inline",
  "version": "0.2.2",
  "description": "Watches text fields and suggests grammar/spelling fixes from a self-hosted LanguageTool server.",
  "browser_specific_settings": {
    "gecko": {
      "id": "lt-inline@example.com",
      "strict_min_version": "142.0",
      "update_url": "https://updates.example.com/addons/updates.json",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "https://languagetool.example.com/*",
    "http://localhost:8081/*"
  ],
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png"
    },
    "default_title": "LanguageTool Inline"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["browser-polyfill.min.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["browser-polyfill.min.js", "content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
