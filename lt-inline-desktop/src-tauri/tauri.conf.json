{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LanguageTool Inline Desktop",
  "version": "0.2.0",
  "identifier": "one.middleton.lt-inline-desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LanguageTool Inline",
        "width": 72,
        "height": 72,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": true
      },
      {
        "label": "settings",
        "title": "LanguageTool Inline — Settings",
        "url": "settings.html",
        "width": 680,
        "height": 740,
        "minWidth": 520,
        "minHeight": 560,
        "resizable": true,
        "visible": false,
        "center": true
      },
      {
        "label": "tour",
        "title": "LanguageTool Inline — Tour",
        "url": "tour.html",
        "width": 560,
        "height": 520,
        "resizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
